# DON'T add secrets etc here: these values will be COMMITTED to git!
# For non-publishable values, add and use a local file .env.local instead!

ENONIC_API_TOKEN=mySecretKey

# Enonic app name, used for convenience in queries and mappings
ENONIC_APP_NAME=com.enonic.app.hmdb

# Absolute URL to the Enonic XP API root
ENONIC_API=http://localhost:8080/api

# Guillotine API descriptor, appended to ENONIC_API
# GUILLOTINE_API=com.enonic.app.guillotine:graphql

# Defaults to the Enonic API, but can be overridden if needed (only in production!)
# ENONIC_MEDIA_CDN=http://localhost:8080/api/

# Absolute URL to Enonic admin, only needed if it differs from the API origin (used for CORS)
# ENONIC_ADMIN=http://localhost:8080

# Enonic XP projects configuration for different locales
ENONIC_MAPPINGS=en:hmdb/hmdb,no:hmdb-no/hmdb
